---
import PostMeta from './PostMeta.astro';
import TagBadge from './TagBadge.astro';
import { sitePath } from '../utils/site-path';
const { post } = Astro.props;
---
<article class="group grid gap-3 border-t border-slate-200/80 py-5 transition-colors first:border-t-0 hover:border-sky-300 sm:grid-cols-[10rem_minmax(0,1fr)_auto] sm:gap-7">
  <div class="pt-0.5"><PostMeta publishedAt={post.publishedAt} categories={post.categories} /></div>
  <div><h2 class="text-base font-medium tracking-[-.025em] text-slate-800 sm:text-lg"><a class="outline-offset-4 transition group-hover:text-sky-700" href={sitePath(`posts/${post.slug}/`)}>{post.title}</a></h2>{post.excerpt && <p class="mt-1.5 max-w-3xl text-sm leading-6 text-slate-500">{post.excerpt}</p>}{post.tags.length > 0 && <div class="mt-3 flex flex-wrap gap-1.5">{post.tags.map((tag: string) => <TagBadge tag={tag} />)}</div>}</div>
  <a class="hidden self-start pt-0.5 font-mono text-xs text-slate-300 transition group-hover:translate-x-1 group-hover:text-sky-500 sm:block" aria-label={`阅读：${post.title}`} href={sitePath(`posts/${post.slug}/`)}>OPEN ↗</a>
</article>
