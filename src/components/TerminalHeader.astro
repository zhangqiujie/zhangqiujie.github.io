---
const { label = 'SYSTEM // ONLINE' } = Astro.props;
---
<div class="flex items-center gap-2 font-mono text-[10px] font-medium tracking-[0.14em] text-slate-400">
  <span class="relative flex h-1.5 w-1.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400 opacity-50"></span><span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-cyan-500"></span></span>
  <span>{label}</span>
</div>
