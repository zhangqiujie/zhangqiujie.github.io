---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts/get-posts';
import { buildTagIndex } from '../../lib/posts/taxonomy';
import { normalizeSlug } from '../../utils/slug';
export async function getStaticPaths() { return [...buildTagIndex(await getPosts()).entries()].map(([tag, posts]) => ({ params: { tag: normalizeSlug(tag) }, props: { tag, posts } })); }
const { tag, posts } = Astro.props;
---
<BaseLayout title={`${tag} / 未命名变量`}><section class="py-12 sm:py-16"><div class="border-b border-slate-200/80 pb-6"><p class="eyebrow">TAG / {tag}</p><div class="mt-2 flex items-end justify-between gap-6"><h1 class="text-3xl font-semibold tracking-[-.055em] text-slate-950">{tag}</h1><span class="font-mono text-[10px] text-slate-400">{posts.length} POSTS</span></div></div><div class="mt-3">{posts.map((post) => <PostCard post={post} />)}</div></section></BaseLayout>
